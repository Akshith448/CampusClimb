# CampusClimb Backend Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# Database Connection (MySQL)
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/campusclimb_nlp

# Supabase Auth Configuration (From Supabase Dashboard -> Project Settings -> API)
# URL: Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# ANON KEY: Project API keys -> anon / public
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# JWT SECRET: Project Settings -> API -> JWT Settings -> JWT Secret
# CRITICAL: Backend uses this secret to verify client JWT signatures locally
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Google Gemini API Key (Required for bilingual Q&A agent in /api/v1/agent/)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Google Cloud Vision API Credentials (for OCR on scanned handwritten notes)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Optional: CORS Allowed Origins (comma-separated, defaults to http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
